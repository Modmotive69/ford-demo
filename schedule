<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Schedule Your FordEngage Session</title>
<link rel="icon" href="/favicon.png">
<link rel="stylesheet" href="https://kit.fontawesome.com/a0d1bd4a2c.css" crossorigin="anonymous">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f0f4f8;min-height:100vh;color:#111827}
.site-header{background:#003478;padding:16px 32px;display:flex;align-items:center;justify-content:space-between}
.logo{color:#fff;font-size:22px;font-weight:800;text-decoration:none}
.logo span{font-weight:300;opacity:.8}
.back-link{color:#93c5fd;font-size:13px;font-weight:600;text-decoration:none}
.back-link:hover{color:#fff}
.container{max-width:860px;margin:0 auto;padding:32px 16px 60px}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin-bottom:24px;background:#fff;border-radius:12px;padding:6px;box-shadow:0 2px 8px rgba(0,0,0,.07)}
.step{text-align:center;padding:10px 6px;border-radius:8px;font-size:12px;font-weight:700;color:#9ca3af;transition:all .2s}
.step.active{background:#003478;color:#fff}
.step.done{color:#16a34a}
.card{background:#fff;border-radius:16px;padding:28px 32px;box-shadow:0 4px 20px rgba(0,0,0,.08);margin-bottom:20px}
.section-title{font-size:18px;font-weight:800;color:#111827;margin-bottom:4px}
.section-sub{font-size:13px;color:#6b7280;margin-bottom:22px}
/* Purpose */
.purpose-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:20px}
.pblock{background:#f8fafc;border-radius:10px;padding:16px 18px;border-left:4px solid #003478}
.pblock.green{border-left-color:#16a34a}
.pblock.amber{border-left-color:#d97706;grid-column:1/-1}
.pblock h4{font-size:11px;font-weight:800;color:#6b7280;text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}
.pblock li{font-size:13px;color:#374151;line-height:1.9;list-style:none}
.pblock li::before{content:"✓ ";color:#16a34a;font-weight:700}
.pblock.amber li{display:inline-block;width:48%;vertical-align:top}
.pblock.amber li::before{content:"• ";color:#d97706}
.purpose-cta{background:#003478;color:#fff;border-radius:10px;padding:13px 18px;font-size:13px;text-align:center;line-height:1.6}
/* Type */
.type-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.type-card{padding:22px;border-radius:12px;border:2px solid #e2e8f0;cursor:pointer;text-align:left;transition:all .15s}
.type-card:hover{border-color:#003478;background:#f0f7ff}
.type-card.sel{border-color:#003478;background:#003478;color:#fff}
.tc-icon{font-size:26px;margin-bottom:10px}
.tc-title{font-size:15px;font-weight:800}
.tc-desc{font-size:12px;opacity:.7;margin-top:6px;line-height:1.55}
/* Calendar */
.cal-layout{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.cal-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.cal-nav-btn{background:none;border:1.5px solid #e2e8f0;border-radius:8px;padding:6px 13px;cursor:pointer;font-size:15px;color:#003478}
.cal-nav-btn:hover{background:#f0f7ff}
.cal-month{font-size:16px;font-weight:800;color:#111827}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
.cal-hdr{text-align:center;font-size:10px;font-weight:700;color:#9ca3af;padding:3px 0}
.cal-day{aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:8px;font-size:13px;font-weight:700;border:1.5px solid #f1f5f9;background:#f9fafb;color:#d1d5db;transition:all .15s}
.cal-day.avail{border-color:#003478;background:#fff;color:#003478;cursor:pointer}
.cal-day.avail:hover{background:#f0f7ff}
.cal-day.sel{background:#003478;color:#fff;border-color:#003478;cursor:pointer}
.cal-day.today{border-color:#0284c7}
.cal-day.empty{border-color:transparent;background:transparent}
.slot-group-title{font-size:10px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;margin:12px 0 6px}
.slot-btn{width:100%;padding:11px 14px;border-radius:10px;border:1.5px solid #e2e8f0;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:space-between;margin-bottom:7px;font-family:Arial,sans-serif;transition:all .15s;text-align:left}
.slot-btn:hover{border-color:#003478;background:#f0f7ff}
.slot-btn.sel{background:#003478;border-color:#003478;color:#fff}
.slot-time{font-size:14px;font-weight:700}
.slot-avail{font-size:11px;font-weight:700;padding:2px 10px;border-radius:10px;background:#dcfce7;color:#16a34a}
.slot-btn.sel .slot-avail{background:rgba(255,255,255,.2);color:#fff}
.no-slots{color:#9ca3af;font-size:13px;text-align:center;padding:48px 10px;line-height:1.7}
/* Confirm */
.field-label{display:block;font-size:12px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px;margin-top:16px}
.field-input{width:100%;padding:11px 14px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:14px;font-family:Arial,sans-serif;color:#111827;transition:border .15s}
.field-input:focus{outline:none;border-color:#003478}
.confirm-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #f1f5f9;font-size:14px}
.confirm-row:last-of-type{border:none}
.cl{color:#6b7280;font-weight:600}.cv{color:#111827;font-weight:700;text-align:right}
/* Buttons */
.btn-primary{padding:12px 24px;background:#003478;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;transition:background .2s;font-family:Arial,sans-serif}
.btn-primary:hover{background:#0254ad}
.btn-primary:disabled{background:#9ca3af;cursor:not-allowed}
.btn-back{padding:10px 18px;background:#f1f5f9;color:#374151;border:1.5px solid #e2e8f0;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;font-family:Arial,sans-serif}
.btn-back:hover{background:#e5e7eb}
.btn-row{display:flex;gap:10px;margin-top:22px}
.err{background:#fee2e2;color:#dc2626;border-radius:8px;padding:11px 14px;font-size:13px;font-weight:600;margin-top:12px;display:none}
.err.show{display:block}
.spinner{display:inline-block;width:16px;height:16px;border:3px solid rgba(255,255,255,.3);border-radius:50%;border-top-color:#fff;animation:spin .7s linear infinite;vertical-align:middle;margin-right:6px}
@keyframes spin{to{transform:rotate(360deg)}}
/* Success */
.success-wrap{text-align:center;padding:32px 16px}
.success-wrap h2{font-size:24px;font-weight:800;color:#003478;margin-bottom:8px}
.success-wrap p{font-size:15px;color:#6b7280;line-height:1.6}
.success-detail{background:#f0f7ff;border-radius:12px;padding:18px 22px;margin:18px auto;max-width:420px;text-align:left}
.sd-row{display:flex;justify-content:space-between;padding:6px 0;font-size:13px;border-bottom:1px solid #e2e8f0}
.sd-row:last-child{border:none}
.sd-l{color:#6b7280;font-weight:600}.sd-v{color:#111827;font-weight:700}
.checklist{background:#f8fafc;border-radius:10px;padding:14px 18px;margin:14px auto;max-width:420px;text-align:left;font-size:13px;color:#374151;line-height:2}
@media(max-width:640px){
  .purpose-grid,.type-grid,.cal-layout{grid-template-columns:1fr}
  .pblock.amber{grid-column:auto}
  .pblock.amber li{display:block;width:100%}
  .card{padding:20px 16px}
  .container{padding:16px 10px 40px}
}
</style>
</head>
<body>

<div class="site-header">
  <a href="/" class="logo">Ford<span>Engage</span></a>
  <a href="/" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to fordengage.com</a>
</div>

<div class="container">

  <div class="steps" id="steps-bar">
    <div class="step active" id="stp1">1 · Session Type</div>
    <div class="step" id="stp2">2 · Pick a Time</div>
    <div class="step" id="stp3">3 · Confirm</div>
  </div>

  <!-- STEP 1: PURPOSE + SESSION TYPE -->
  <div id="scr-type">
    <div class="card">
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:20px">
        <div style="width:48px;height:48px;background:#003478;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;flex-shrink:0"><i class="fa-solid fa-chalkboard-user"></i></div>
        <div>
          <div style="font-size:20px;font-weight:800;color:#111827">Schedule Your FordEngage Session</div>
          <div style="font-size:13px;color:#6b7280;margin-top:2px">Book your training or demo — takes 2 minutes</div>
        </div>
      </div>
      <div class="purpose-grid">
        <div class="pblock">
          <h4><i class="fa-solid fa-bullseye" style="margin-right:5px"></i>What This Session Is</h4>
          <ul>
            <li>Live session with your SmartDealer trainer</li>
            <li>FordEngage platform walkthrough</li>
            <li>Full activation of your account</li>
            <li>Q&amp;A with your trainer</li>
          </ul>
        </div>
        <div class="pblock green">
          <h4><i class="fa-solid fa-circle-check" style="margin-right:5px"></i>What Happens After</h4>
          <ul>
            <li>FordEngage account goes live</li>
            <li>Staff portal access activated</li>
            <li>DMS &amp; FAD integration confirmed</li>
            <li>Dedicated support contact assigned</li>
          </ul>
        </div>
        <div class="pblock amber">
          <h4><i class="fa-solid fa-clipboard-list" style="margin-right:5px"></i>Have These Ready</h4>
          <ul>
            <li>DMS login credentials</li>
            <li>FAD portal access</li>
            <li>F&amp;I manager available</li>
            <li>Parts &amp; Sales managers available</li>
          </ul>
        </div>
      </div>
      <div class="purpose-cta"><strong>Sessions run Monday–Friday, 9 AM–4 PM ET.</strong><br>You'll receive a confirmation email with connection details after booking.</div>
    </div>

    <div class="card">
      <div class="section-title">What would you like to schedule?</div>
      <div class="section-sub">Choose the session that fits where you are in the process.</div>
      <div class="type-grid">
        <div class="type-card" id="tc-training">
          <div class="tc-icon"><i class="fa-solid fa-graduation-cap" style="color:#003478"></i></div>
          <div class="tc-title">Onboarding Training</div>
          <div class="tc-desc">Full activation — DMS integration, FAD setup, staff walkthrough. 60 minutes. For dealerships ready to go live.</div>
        </div>
        <div class="type-card" id="tc-demo">
          <div class="tc-icon"><i class="fa-solid fa-presentation-screen" style="color:#7c3aed"></i></div>
          <div class="tc-title">Platform Demo</div>
          <div class="tc-desc">See FordEngage before full activation. 30–45 minutes. Great for GMs and decision-makers evaluating the program.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- STEP 2: CALENDAR + SLOTS -->
  <div id="scr-calendar" style="display:none">
    <div class="card">
      <div style="font-size:16px;font-weight:800;color:#111827;margin-bottom:4px" id="cal-session-label"></div>
      <div class="section-sub">Pick a date then choose your time slot.</div>
      <div class="cal-layout">
        <div>
          <div class="cal-nav">
            <button class="cal-nav-btn" id="cal-prev"><i class="fa-solid fa-chevron-left"></i></button>
            <div class="cal-month" id="cal-month-label"></div>
            <button class="cal-nav-btn" id="cal-next"><i class="fa-solid fa-chevron-right"></i></button>
          </div>
          <div class="cal-grid">
            <div class="cal-hdr">Su</div><div class="cal-hdr">Mo</div><div class="cal-hdr">Tu</div>
            <div class="cal-hdr">We</div><div class="cal-hdr">Th</div><div class="cal-hdr">Fr</div><div class="cal-hdr">Sa</div>
            <div id="cal-days" style="display:contents"></div>
          </div>
        </div>
        <div id="slots-panel">
          <div class="no-slots"><i class="fa-regular fa-calendar" style="font-size:32px;display:block;margin-bottom:10px;opacity:.3"></i>Select a date<br>to see available times</div>
        </div>
      </div>
      <div class="btn-row">
        <button class="btn-back" id="back-to-type"><i class="fa-solid fa-arrow-left"></i> Back</button>
        <button class="btn-primary" id="continue-btn" style="display:none;flex:1"><i class="fa-solid fa-arrow-right"></i> Continue</button>
      </div>
    </div>
  </div>

  <!-- STEP 3: CONFIRM -->
  <div id="scr-confirm" style="display:none">
    <div class="card">
      <div class="section-title"><i class="fa-solid fa-calendar-check" style="color:#003478;margin-right:8px"></i>Confirm Your Booking</div>
      <div class="section-sub">Fill in your details and confirm your session.</div>
      <div id="confirm-rows"></div>
      <label class="field-label" for="inp-dealer">Dealership Name</label>
      <input class="field-input" type="text" id="inp-dealer" placeholder="e.g. Bellingham Ford">
      <label class="field-label" for="inp-name">Your Name</label>
      <input class="field-input" type="text" id="inp-name" placeholder="e.g. Jeremy Morris">
      <label class="field-label" for="inp-email">Email Address</label>
      <input class="field-input" type="email" id="inp-email" placeholder="you@dealership.com">
      <label class="field-label" for="confirm-notes">Notes for your trainer <span style="font-weight:400;color:#9ca3af;text-transform:none;letter-spacing:0">(optional)</span></label>
      <textarea class="field-input" id="confirm-notes" style="min-height:70px;resize:vertical" placeholder="DMS system, staff attending, specific questions..."></textarea>
      <div class="btn-row">
        <button class="btn-back" id="back-to-cal"><i class="fa-solid fa-arrow-left"></i> Back</button>
        <button class="btn-primary" id="confirm-btn" style="flex:2"><i class="fa-solid fa-check"></i> Confirm Booking</button>
      </div>
      <div class="err" id="confirm-err"></div>
    </div>
  </div>

  <!-- SUCCESS -->
  <div id="scr-success" style="display:none">
    <div class="card success-wrap">
      <div style="font-size:60px;margin-bottom:16px">🎉</div>
      <h2>You're Booked!</h2>
      <p>Your FordEngage session is confirmed.<br>A SmartDealer trainer will reach out with connection details.</p>
      <div class="success-detail" id="success-rows"></div>
      <div class="checklist">
        <strong style="display:block;margin-bottom:4px;color:#111827"><i class="fa-solid fa-clipboard-list" style="color:#003478;margin-right:6px"></i>Have These Ready</strong>
        ✅ DMS login credentials<br>✅ FAD portal access<br>✅ F&amp;I, Parts &amp; Sales managers available<br>✅ Stable internet connection
      </div>
      <p style="margin-top:16px;font-size:13px;color:#9ca3af">Questions? <a href="mailto:support@smartdealer.com" style="color:#003478">support@smartdealer.com</a></p>
    </div>
  </div>

</div>

<script>
var API = 'https://fordengage-sales.pages.dev/api/training';
var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];

var SC = {
  sessionType: null,
  calYear: new Date().getFullYear(),
  calMonth: new Date().getMonth(),
  availableDays: [],
  selectedDate: null,
  selectedSlot: null,
  loadedMonths: {}
};

function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function fmtTime(t){ var p=t.split(':'),h=parseInt(p[0]),m=p[1],ap=h>=12?'PM':'AM'; return (h>12?h-12:(h||12))+':'+m+' '+ap+' ET'; }
function fmtDate(ds){ return new Date(ds+'T12:00:00').toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'}); }
function cRow(l,v){ return '<div class="confirm-row"><span class="cl">'+esc(l)+'</span><span class="cv">'+esc(v)+'</span></div>'; }
function sRow(l,v){ return '<div class="sd-row"><span class="sd-l">'+esc(l)+'</span><span class="sd-v">'+esc(v)+'</span></div>'; }

function showScreen(name){
  ['type','calendar','confirm','success'].forEach(function(s){
    document.getElementById('scr-'+s).style.display = s===name?'block':'none';
  });
  var stepMap={type:1,calendar:2,confirm:3,success:3};
  var cur=stepMap[name]||1;
  [1,2,3].forEach(function(n){
    var el=document.getElementById('stp'+n);
    if(n===cur) el.className='step active';
    else if(n<cur) el.className='step done';
    else el.className='step';
  });
  if(name==='success') document.getElementById('steps-bar').style.display='none';
  window.scrollTo({top:0,behavior:'smooth'});
}

// Step 1 — type selection
document.getElementById('tc-training').addEventListener('click', function(){ selectType('training'); });
document.getElementById('tc-demo').addEventListener('click', function(){ selectType('demo'); });

function selectType(type){
  SC.sessionType=type;
  SC.selectedDate=null; SC.selectedSlot=null;
  document.getElementById('tc-training').className='type-card'+(type==='training'?' sel':'');
  document.getElementById('tc-demo').className='type-card'+(type==='demo'?' sel':'');
  document.getElementById('cal-session-label').innerHTML = type==='training'
    ? '<i class="fa-solid fa-graduation-cap" style="color:#003478;margin-right:8px"></i>Onboarding Training — 60 minutes'
    : '<i class="fa-solid fa-presentation-screen" style="color:#7c3aed;margin-right:8px"></i>Platform Demo — 30–45 minutes';
  document.getElementById('continue-btn').style.display='none';
  document.getElementById('slots-panel').innerHTML='<div class="no-slots"><i class="fa-regular fa-calendar" style="font-size:32px;display:block;margin-bottom:10px;opacity:.3"></i>Select a date<br>to see available times</div>';
  loadMonthSlots(SC.calYear, SC.calMonth, function(){ renderCal(); showScreen('calendar'); });
}

// Load all available days (next 45 days, weekdays only)
function loadMonthSlots(year, month, cb){
  if(SC.availableDays.length){ if(cb) cb(); return; }
  fetch(API+'/public-availability')
    .then(function(r){ return r.json(); })
    .then(function(data){
      SC.availableDays = data.available_days||[];
      if(cb) cb();
    }).catch(function(){ if(cb) cb(); });
}

// Calendar
document.getElementById('cal-prev').addEventListener('click', function(){
  SC.calMonth--; if(SC.calMonth<0){SC.calMonth=11;SC.calYear--;}
  loadMonthSlots(SC.calYear,SC.calMonth,renderCal);
});
document.getElementById('cal-next').addEventListener('click', function(){
  SC.calMonth++; if(SC.calMonth>11){SC.calMonth=0;SC.calYear++;}
  loadMonthSlots(SC.calYear,SC.calMonth,renderCal);
});
document.getElementById('back-to-type').addEventListener('click', function(){ showScreen('type'); });
document.getElementById('continue-btn').addEventListener('click', function(){ buildConfirm(); showScreen('confirm'); });

function renderCal(){
  document.getElementById('cal-month-label').textContent=MONTHS[SC.calMonth]+' '+SC.calYear;
  var first=new Date(SC.calYear,SC.calMonth,1).getDay();
  var days=new Date(SC.calYear,SC.calMonth+1,0).getDate();
  var today=new Date().toISOString().slice(0,10);
  var html='';
  for(var i=0;i<first;i++) html+='<div class="cal-day empty"></div>';
  for(var d=1;d<=days;d++){
    var ds=SC.calYear+'-'+String(SC.calMonth+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');
    var has=SC.availableDays.some(function(x){return x.date===ds && x.slots && x.slots.length;});
    var sel=SC.selectedDate===ds;
    var cls='cal-day'+(has?' avail':'')+(sel?' sel':'')+(ds===today?' today':'');
    html+='<div class="'+cls+'"'+(has?' data-date="'+ds+'"':'')+'>'+d+'</div>';
  }
  document.getElementById('cal-days').innerHTML=html;
  document.getElementById('cal-days').parentElement.onclick=function(e){
    var el=e.target.closest('.avail');
    if(!el||!el.dataset.date) return;
    selectDate(el.dataset.date);
  };
}

function selectDate(ds){
  SC.selectedDate=ds; SC.selectedSlot=null;
  document.getElementById('continue-btn').style.display='none';
  renderCal();
  var day=SC.availableDays.find(function(x){return x.date===ds;});
  renderSlots(day?day.slots:[]);
}

function renderSlots(slots){
  if(!slots||!slots.length){
    document.getElementById('slots-panel').innerHTML='<div class="no-slots">No available slots this day.<br>Try another date.</div>';
    return;
  }
  var label=fmtDate(SC.selectedDate);
  var morning=slots.filter(function(s){return (s.slot_start||s.scheduled_time||'12:00')<'12:00';});
  var afternoon=slots.filter(function(s){return (s.slot_start||s.scheduled_time||'12:00')>='12:00';});
  function slotEl(s){
    var st=s.slot_start||s.scheduled_time;
    var sel=SC.selectedSlot===st;
    return '<button class="slot-btn'+(sel?' sel':'')+'" data-slot="'+st+'">'
      +'<span class="slot-time">'+fmtTime(st)+'</span>'
      +'<span class="slot-avail">Available</span></button>';
  }
  var h='<div style="font-size:13px;font-weight:700;color:#003478;margin-bottom:12px">'+esc(label)+'</div>';
  if(morning.length) h+='<div class="slot-group-title"><i class="fa-solid fa-sun"></i> Morning</div>'+morning.map(slotEl).join('');
  if(afternoon.length) h+='<div class="slot-group-title"><i class="fa-solid fa-cloud-sun"></i> Afternoon</div>'+afternoon.map(slotEl).join('');
  document.getElementById('slots-panel').innerHTML=h;
  document.getElementById('slots-panel').onclick=function(e){
    var btn=e.target.closest('.slot-btn');
    if(!btn) return;
    SC.selectedSlot=btn.dataset.slot;
    renderSlots(slots);
    document.getElementById('continue-btn').style.display='flex';
  };
}

// Step 3 — confirm
document.getElementById('back-to-cal').addEventListener('click', function(){ showScreen('calendar'); });
document.getElementById('confirm-btn').addEventListener('click', doBook);

function buildConfirm(){
  var typeLabel=SC.sessionType==='training'?'Onboarding Training (60 min)':'Platform Demo (30–45 min)';
  document.getElementById('confirm-rows').innerHTML=
    cRow('Session',typeLabel)+cRow('Date',fmtDate(SC.selectedDate))+cRow('Time',fmtTime(SC.selectedSlot)+' Eastern')+cRow('Trainer','SmartDealer Team');
}

function doBook(){
  var dealer=document.getElementById('inp-dealer').value.trim();
  var name=document.getElementById('inp-name').value.trim();
  var email=document.getElementById('inp-email').value.trim();
  var errEl=document.getElementById('confirm-err');
  errEl.className='err';
  if(!dealer||!name||!email){ errEl.textContent='Please fill in dealership name, your name, and email.'; errEl.className='err show'; return; }
  var btn=document.getElementById('confirm-btn');
  btn.disabled=true; btn.innerHTML='<span class="spinner"></span> Booking...';
  var notes=(document.getElementById('confirm-notes').value||'')+' ['+dealer+' | '+name+' | '+email+'] ['+(SC.sessionType==='demo'?'Demo':'Training')+']';
  // Use public-book with a guest token approach — post as a walk-in booking
  fetch(API+'/public-walkin', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({dealer_name:dealer,contact_name:name,email:email,session_type:SC.sessionType,scheduled_date:SC.selectedDate,scheduled_time:SC.selectedSlot,notes:notes})
  }).then(function(r){ return r.json().then(function(d){return{ok:r.ok,data:d};}); })
  .then(function(res){
    btn.disabled=false; btn.innerHTML='<i class="fa-solid fa-check"></i> Confirm Booking';
    if(!res.ok){ errEl.textContent=res.data.error||'Something went wrong. Please try again.'; errEl.className='err show'; return; }
    var typeLabel=SC.sessionType==='training'?'Onboarding Training':'Platform Demo';
    document.getElementById('success-rows').innerHTML=sRow('Dealership',dealer)+sRow('Contact',name)+sRow('Session',typeLabel)+sRow('Date',fmtDate(SC.selectedDate))+sRow('Time',fmtTime(SC.selectedSlot)+' ET');
    showScreen('success');
  }).catch(function(){ btn.disabled=false; btn.innerHTML='<i class="fa-solid fa-check"></i> Confirm Booking'; errEl.textContent='Connection error. Please try again.'; errEl.className='err show'; });
}
</script>
</body>
</html>
